# ===========================================================================
# .gitignore para Proyecto Sistema Basado en Conocimiento (SBC) - Python & Streamlit
# ===========================================================================

# --- Entornos Virtuales ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Bytecode y Cache de Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Streamlit ---
.streamlit/secrets.toml

# --- Pruebas y Cobertura ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Empaquetado y Distribución ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Logs y Archivos Temporales ---
*.log
*.tmp
*.bak
*.swp
*~

# --- Configuraciones de IDEs y Editores ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Archivos del Sistema Operativo ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
